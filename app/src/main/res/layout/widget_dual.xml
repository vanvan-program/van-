<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp"
    android:background="@drawable/widget_dark">
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="20dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#D8D8D8"
            android:textSize="14sp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#747684"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:singleLine="true" />
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="22dp"
            android:layout_height="match_parent"
            android:text="↻"
            android:gravity="center"
            android:textSize="15sp"
            android:contentDescription="刷新小组件"
            android:includeFontPadding="false"
            android:textColor="#D8D8D8" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/today_column"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginEnd="6dp">
            <TextView
                android:id="@+id/today_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="今天"
                android:layout_marginBottom="4dp"
                android:textColor="#D8D8D8"
                android:textSize="13sp"
                android:textStyle="normal"
                android:includeFontPadding="false" />
            <FrameLayout
                android:id="@+id/today_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
            <ListView
                android:id="@+id/today_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@android:color/transparent"
                android:dividerHeight="6dp"
                android:scrollbars="none" />
            <TextView
                android:id="@+id/today_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#D8D8D8"
                android:textSize="13sp"
                android:gravity="center_vertical" />
            </FrameLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/widget_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="19dp"
            android:background="#D9D9E3"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:id="@+id/tomorrow_column"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginStart="6dp">
            <TextView
                android:id="@+id/tomorrow_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="明天"
                android:layout_marginBottom="4dp"
                android:textColor="#D8D8D8"
                android:textSize="13sp"
                android:textStyle="normal"
                android:includeFontPadding="false" />
            <FrameLayout
                android:id="@+id/tomorrow_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
            <ListView
                android:id="@+id/tomorrow_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@android:color/transparent"
                android:dividerHeight="6dp"
                android:scrollbars="none" />
            <TextView
                android:id="@+id/tomorrow_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#D8D8D8"
                android:textSize="13sp"
                android:gravity="center_vertical" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_updated"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#BBBBBB"
        android:textSize="9sp"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
